# =============================================================================
# FundOS backend environment — gyain enterprise deployment
# Node: befundos.gyain.com   (private IP 10.130.0.34)
# Install root: /d01/fundos   Media: /d01/fundos-data/media
#
# Copy to /etc/fundos/fundos.env, replace every CHANGE_ME, then:
#   sudo chown root:fundos /etc/fundos/fundos.env && sudo chmod 640 /etc/fundos/fundos.env
#
# NOTE ON MULTITENANCY: FundOS is already multitenant. The tenant is fixed at
# login and carried in the JWT (see fundos/core/auth.py) with row-level
# isolation by tenant_id — it is NEVER derived from the URL or subdomain.
# There is therefore no per-tenant host/env setting: one database, one
# `manage.py migrate`, one env file serves all tenants.
# =============================================================================

DJANGO_SETTINGS_MODULE=fundos.settings.prod

# --- Core secrets (generate each: openssl rand -hex 48) ---
FUNDOS_SECRET_KEY=CHANGE_ME_64_HEX
FUNDOS_JWT_SECRET=CHANGE_ME_DIFFERENT_64_HEX

# --- Hosts & CORS ---
# The API is reached as befundos.gyain.com; requests also arrive proxied from
# the frontend node carrying Host: fundos.gyain.com. Accept both, plus the
# private IP for local health checks. No wildcard in prod.
FUNDOS_ALLOWED_HOSTS=befundos.gyain.com,fundos.gyain.com,10.130.0.34,localhost,127.0.0.1
# Same-origin frontend origin (browser only ever sees https://fundos.gyain.com):
FUNDOS_CORS_ALLOWED_ORIGINS=https://fundos.gyain.com

# --- Database (bind on private IP) ---
FUNDOS_DB_NAME=fundos
FUNDOS_DB_USER=fundos
FUNDOS_DB_PASSWORD=CHANGE_ME_STRONG
FUNDOS_DB_HOST=10.130.0.34
FUNDOS_DB_PORT=5432

# --- Redis / Celery (bind on private IP) ---
# base URL only; prod settings derive /0 broker, /1 cache, /2 results
FUNDOS_REDIS_URL=redis://10.130.0.34:6379

# --- Email (OTP delivery) ---
FUNDOS_SMTP_HOST=smtp.example.com
FUNDOS_SMTP_PORT=587
FUNDOS_SMTP_USER=fundos-mailer
FUNDOS_SMTP_PASSWORD=CHANGE_ME
FUNDOS_SMTP_TLS=true
FUNDOS_FROM_EMAIL=no-reply@gyain.com

# --- File storage: local volume on /d01 ---
FUNDOS_STORAGE_BACKEND=local
FUNDOS_STORAGE_BUCKET=fundos-materials
FUNDOS_STORAGE_LOCAL_ROOT=/d01/fundos-data/media

# --- Virus scanning (bind on private IP; prod fails closed) ---
FUNDOS_CLAMAV_HOST=10.130.0.34
FUNDOS_CLAMAV_PORT=3310

# --- Presentation & FX ---
FUNDOS_PRESENTATION_CCY=INR
FUNDOS_USD_INR=84.0

# --- Logging ---
FUNDOS_LOG_LEVEL=INFO
